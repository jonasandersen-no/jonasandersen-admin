  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>npm install vue dependencies</id>
            <phase>initialize</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <workingDirectory>${project.basedir}/src/main/vueapp</workingDirectory>
              <executable>npm</executable>
              <arguments>
                <argument>install</argument>
                <argument>--no-audit</argument>
                <argument>--no-fund</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>npx typescript fetch</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <workingDirectory>${project.basedir}</workingDirectory>
              <executable>npx</executable>
              <arguments>
                <argument>openapi-typescript</argument>
                <argument>src/main/api/api.yaml</argument>
                <argument>--output</argument>
                <argument>${project.basedir}/src/main/vueapp/src/generated/api.ts</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm build the vue app</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <workingDirectory>${project.basedir}/src/main/vueapp</workingDirectory>
              <executable>npm</executable>
              <arguments>
                <argument>run</argument>
                <argument>build</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Copy the vuejs dist folder into Spring Boot target static
      folder.
     Make sure npm run build has been executed-->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>Copy my VueJS app into my Spring Boot target static
              folder
            </id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>target/classes/static</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/src/main/vueapp/dist</directory>
                  <filtering>true</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.27.0</version>
        <executions>
          <execution>
            <id>Java</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <generatorName>spring</generatorName>
              <inputSpec>${project.basedir}/src/main/api/api.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot4>true</useSpringBoot4>
                <useJackson3>true</useJackson3>
                <apiPackage>no.jonasandersen.admin.generated.api</apiPackage>
                <modelPackage>no.jonasandersen.admin.generated.model</modelPackage>
                <configPackage>no.jonasandersen.admin.generated.configuration</configPackage>
                <basePackage>no.jonasandersen.admin.generated</basePackage>
              </configOptions>
              <generateApis>true</generateApis>
              <generateModels>true</generateModels>
              <generateSupportingFiles>true</generateSupportingFiles>
            </configuration>
          </execution>
        </executions>
      </plugin>


      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <execution>
            <id>default-test</id>
            <configuration>
              <excludedGroups>integration,manual</excludedGroups>
            </configuration>
          </execution>
          <execution>
            <id>integration-tests</id>
            <phase>integration-test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <groups>integration</groups>
              <excludedGroups>manual</excludedGroups>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
          <execution>
            <goals>
              <goal>build-image-no-fork</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <skip>${docker.skip}</skip>
          <image>
            <builder>paketobuildpacks/builder-jammy-buildpackless-tiny</builder>
            <name>bjoggis/jonasandersen-admin:v${project.version}-${os.detected.arch}</name>
            <buildpacks>
              <buildpack>paketobuildpacks/java</buildpack>
            </buildpacks>
            <env>
              <BP_JVM_VERSION>27</BP_JVM_VERSION>
            </env>
          </image>
        </configuration>
      </plugin>
    </plugins>
  </build>


</project>